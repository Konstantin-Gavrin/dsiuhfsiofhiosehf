# Environment configuration for power-bot
# Copy this file to .env and adjust values as needed

# Server configuration
PORT=3000
HOST=0.0.0.0

# Elering API configuration
ELERING_API_URL=https://dashboard.elering.ee/api/nps/price

# Price threshold in EUR/kWh (default: 0.10 = 10 cents)
# Device will turn ON when price <= threshold
# Device will turn OFF when price > threshold
THRESHOLD_EUR=0.10

# Price check interval in milliseconds (default: 300000 = 5 minutes)
CHECK_INTERVAL_MS=300000

# Health check enabled (for Coolify platform)
HEALTH_CHECK_ENABLED=true
