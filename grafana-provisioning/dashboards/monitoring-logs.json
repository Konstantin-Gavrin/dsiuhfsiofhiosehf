{
  "dashboard": {
    "title": "Power Bot - Log Analysis",
    "description": "Real-time logs from Loki",
    "tags": ["power-bot", "logs"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "All Logs",
        "type": "logs",
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "{service=\"power-bot\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "ERROR Logs",
        "type": "logs",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "{service=\"power-bot\", level=\"ERROR\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "WARN Logs",
        "type": "logs",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "expr": "{service=\"power-bot\", level=\"WARN\"}",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
